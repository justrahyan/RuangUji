# Gunakan AI_PROVIDER=gemini untuk mode AI.
# Gunakan AI_PROVIDER=local jika ingin fallback/offline tanpa API.

AI_PROVIDER=gemini

# Gemini API
# Bisa satu key:
# GEMINI_API_KEY=api_key_utama
#
# Bisa banyak key, pisahkan dengan koma:
# GEMINI_API_KEY=api_key_1,api_key_2,api_key_3
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.5-flash

VOICE_DEFAULT=calm-female

# Limit sesi latihan
TRAINING_SESSION_LIMIT=5
TRAINING_SESSION_WINDOW_HOURS=6

# Jangan aktifkan di production
DEV_BYPASS_USAGE_LIMIT=false

# Mode hemat API dan fallback berbasis konteks
ENABLE_CONTEXTUAL_TEMPLATE_FALLBACK=true
AI_EVALUATE_EACH_ANSWER=false
AI_FINAL_EVALUATION=true